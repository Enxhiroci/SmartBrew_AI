# Copy this file to .env (in the project root). .env is intentionally git-ignored.
# Windows PowerShell: Copy-Item .env.example .env
# Keep real credentials in .env, never in Git or screenshots.

# Optional demo admin PIN; only used to seed a NEW database (default is 2468).
SMARTBREW_ADMIN_PIN=2468
# SMARTBREW_DB_PATH=smartbrew.db

# Real receipt emails via your own SMTP account. The payment remains simulated.
# Example: Gmail SMTP is smtp.gmail.com. If eligible, use a provider-issued app password.
# The SMTP_USER, SMTP_PASSWORD and SMTP_FROM values are empty until you fill them in.
# For other providers, use their actual host, port and TLS mode.
SMARTBREW_SMTP_HOST=smtp.gmail.com
SMARTBREW_SMTP_PORT=587
SMARTBREW_SMTP_SECURITY=starttls
SMARTBREW_SMTP_USER=
SMARTBREW_SMTP_PASSWORD=
SMARTBREW_SMTP_FROM=
